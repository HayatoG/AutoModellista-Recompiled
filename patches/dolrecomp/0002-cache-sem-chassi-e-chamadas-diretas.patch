+    // Opt-in (DOLRECOMP_C_DIRECT_CALLS=1): every chunk of every section is known
+    // up front, so a cross-chunk bl can call func_<chunk>() directly.
+    u32* direct_starts = NULL;
+    u32* direct_ends = NULL;
+    {
+        const char* direct = getenv("DOLRECOMP_C_DIRECT_CALLS");
+        u32 total = 0;
+        for (u32 s = 0; s < section_count; s++)
+            if (sections[s].size && sections[s].data)
+                total += (sections[s].size / 4 + chunk_instructions - 1u) / chunk_instructions;
+        if (direct && direct[0] == '1' && total) {
+            direct_starts = (u32*)calloc(total, sizeof(u32));
+            direct_ends = (u32*)calloc(total, sizeof(u32));
+        }
+        if (direct_starts && direct_ends) {
+            u32 n = 0;
+            for (u32 s = 0; s < section_count; s++) {
+                if (!sections[s].size || !sections[s].data)
+                    continue;
+                u32 insts_in_section = sections[s].size / 4;
+                for (u32 start = 0; start < insts_in_section; start += chunk_instructions) {
+                    u32 len = insts_in_section - start;
+                    if (len > chunk_instructions)
+                        len = chunk_instructions;
+                    direct_starts[n] = sections[s].address + start * 4u;
+                    direct_ends[n] = direct_starts[n] + len * 4u;
+                    n++;
+                }
+            }
+            // Sections may not be in address order; insertion sort keeps the pairs together.
+            for (u32 i = 1; i < n; i++) {
+                u32 ks = direct_starts[i], ke = direct_ends[i], j = i;
+                while (j > 0 && direct_starts[j - 1] > ks) {
+                    direct_starts[j] = direct_starts[j - 1];
+                    direct_ends[j] = direct_ends[j - 1];
+                    j--;
+                }
+                direct_starts[j] = ks;
+                direct_ends[j] = ke;
+            }
+            emit_set_chunk_table_bounds(direct_starts, direct_ends, n);
+            printf("direct cross-chunk calls: %u chunks\n", n);
+        }
+    }
+
