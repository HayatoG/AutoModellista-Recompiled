 // read-only thereafter, so no locking. NULL means "no table": every cross-chunk
 // branch takes the safe return-to-chassis path.
 static const u32* g_chunk_starts = NULL;
+static const u32* g_chunk_ends = NULL;
 static u32 g_chunk_count = 0;
 
+// Targets that must keep going through the chassis (the runtime hooks them by
+// pc), from DOLRECOMP_C_NO_DIRECT_CALL: comma-separated hex addresses.
+#define NO_DIRECT_CALL_MAX 64u
+static u32 g_no_direct[NO_DIRECT_CALL_MAX];
+static u32 g_no_direct_count = 0;
+
+static void load_no_direct_calls(void) {
+    g_no_direct_count = 0;
+    const char* list = getenv("DOLRECOMP_C_NO_DIRECT_CALL");
+    while (list && *list && g_no_direct_count < NO_DIRECT_CALL_MAX) {
+        char* end = NULL;
+        unsigned long value = strtoul(list, &end, 16);
+        if (end == list)
+            break;
+        g_no_direct[g_no_direct_count++] = (u32)value;
+        list = *end == ',' ? end + 1 : end;
+    }
+}
+
+static bool direct_call_allowed(u32 target) {
+    for (u32 i = 0; i < g_no_direct_count; i++)
+        if (g_no_direct[i] == target)
+            return false;
+    return true;
+}
+
 void emit_set_chunk_table(const u32* starts, u32 count) {
+    emit_set_chunk_table_bounds(starts, NULL, count);
+}
+
+void emit_set_chunk_table_bounds(const u32* starts, const u32* ends, u32 count) {
     g_chunk_starts = count ? starts : NULL;
+    g_chunk_ends = count ? ends : NULL;
     g_chunk_count = count ? count : 0;
+    load_no_direct_calls();
 }
 
