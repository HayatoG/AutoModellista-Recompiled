+/**
+ * Binds read-write storage textures for use on the fragment shader.
+ *
+ * These textures must have been created with
+ * SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ_WRITE, and the device must report
+ * SDL_PROP_GPU_DEVICE_GRAPHICS_STORAGE_READ_WRITE_BOOLEAN. Each binding
+ * selects one mip level and one layer. Cycling is not possible inside a
+ * render pass, so `cycle` must be false.
+ *
+ * Writes made by one render pass are visible to every later pass, copy or
+ * download. Inside a render pass, overlapping fragments are only ordered if
+ * the shader asks for it (ROV, fragment shader interlock or raster order
+ * groups; see SDL_PROP_GPU_DEVICE_RASTER_ORDERED_STORAGE_BOOLEAN).
+ *
+ * Be sure your shader is set up according to the requirements documented in
+ * SDL_CreateGPUShader() (SDL_PROP_GPU_SHADER_CREATE_NUM_READWRITE_STORAGE_TEXTURES_NUMBER).
+ *
+ * \param render_pass a render pass handle.
+ * \param first_slot the fragment read-write storage texture slot to begin
+ *                   binding from.
+ * \param storage_texture_bindings an array of read-write storage texture
+ *                                 bindings.
+ * \param num_bindings the number of bindings in the array.
+ *
+ * \since This function is a local patch on SDL 3.4.18 (Auto Modellista
+ *        Recompiled); it is not part of upstream SDL.
+ *
+ * \sa SDL_CreateGPUShader
+ */
+extern SDL_DECLSPEC void SDLCALL SDL_BindGPUFragmentReadWriteStorageTextures(
+    SDL_GPURenderPass *render_pass,
+    Uint32 first_slot,
+    const SDL_GPUStorageTextureReadWriteBinding *storage_texture_bindings,
+    Uint32 num_bindings);
+
