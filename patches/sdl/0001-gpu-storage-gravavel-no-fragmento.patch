+void SDL_BindGPUFragmentReadWriteStorageTextures(
+    SDL_GPURenderPass *render_pass,
+    Uint32 first_slot,
+    const SDL_GPUStorageTextureReadWriteBinding *storage_texture_bindings,
+    Uint32 num_bindings)
+{
+    CHECK_PARAM(render_pass == NULL) {
+        SDL_InvalidParamError("render_pass");
+        return;
+    }
+    CHECK_PARAM(storage_texture_bindings == NULL && num_bindings > 0) {
+        SDL_InvalidParamError("storage_texture_bindings");
+        return;
+    }
+    CHECK_PARAM(first_slot + num_bindings > MAX_FRAGMENT_WRITE_TEXTURES) {
+        SDL_SetError("first_slot + num_bindings exceeds MAX_FRAGMENT_WRITE_TEXTURES");
+        return;
+    }
+    CHECK_PARAM(!RENDERPASS_DEVICE->graphics_storage_read_write) {
+        SDL_SetError("Fragment read-write storage textures are not enabled on this device");
+        return;
+    }
+
+    if (RENDERPASS_DEVICE->debug_mode) {
+        CHECK_RENDERPASS
+
+        for (Uint32 i = 0; i < num_bindings; i += 1) {
+            TextureCommonHeader *header = (TextureCommonHeader *)storage_texture_bindings[i].texture;
+            if (header == NULL || !(header->info.usage & SDL_GPU_TEXTUREUSAGE_GRAPHICS_STORAGE_READ_WRITE)) {
+                SDL_assert_release(!"Texture must be created with GRAPHICS_STORAGE_READ_WRITE flag");
+                return;
+            }
+            if (storage_texture_bindings[i].cycle) {
+                SDL_assert_release(!"Fragment read-write storage textures cannot be cycled inside a render pass");
+                return;
+            }
+            if (storage_texture_bindings[i].layer >= header->info.layer_count_or_depth) {
+                SDL_assert_release(!"Storage texture layer index must be less than the texture's layer count!");
+                return;
+            }
+            if (storage_texture_bindings[i].mip_level >= header->info.num_levels) {
+                SDL_assert_release(!"Storage texture mip level must be less than the texture's level count!");
+                return;
+            }
+            ((RenderPass *)render_pass)->fragment_read_write_storage_texture_bound[first_slot + i] = true;
+        }
+    }
+
+    RENDERPASS_DEVICE->BindFragmentReadWriteStorageTextures(
+        RENDERPASS_COMMAND_BUFFER,
+        first_slot,
+        storage_texture_bindings,
+        num_bindings);
+}
