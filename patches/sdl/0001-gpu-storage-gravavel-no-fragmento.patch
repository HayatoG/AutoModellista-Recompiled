+            id<MTLTexture> textureView = texture->handle;
+
+            METAL_INTERNAL_TrackTexture(metalCommandBuffer, texture);
+
+            // A single-level, single-layer texture is bound as is; otherwise one mip level and one layer, as in compute.
+            if (textureContainer->header.info.num_levels > 1 || textureContainer->header.info.layer_count_or_depth > 1) {
+                textureView = [texture->handle newTextureViewWithPixelFormat:SDLToMetal_TextureFormat(textureContainer->header.info.format)
+                                                                 textureType:SDLToMetal_TextureType(textureContainer->header.info.type, false)
+                                                                      levels:NSMakeRange(storageTextureBindings[i].mip_level, 1)
+                                                                      slices:NSMakeRange(storageTextureBindings[i].layer, 1)];
+            }
+
+            if (metalCommandBuffer->fragmentReadWriteTextures[firstSlot + i] != textureView) {
+                metalCommandBuffer->fragmentReadWriteTextures[firstSlot + i] = textureView;
+                metalCommandBuffer->needFragmentReadWriteStorageTextureBind = true;
+            }
+        }
+    }
